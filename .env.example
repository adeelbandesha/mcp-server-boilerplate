# Copy to .env (git-ignored). Read by `npm start` / `npm run start:http`;
# Claude Desktop and other launchers pass variables through their own "env" config instead.

# stdio (Claude Desktop, local clients) or http (Streamable HTTP on /mcp)
MCP_TRANSPORT=stdio

# debug | info | warn | error — always written to stderr, never stdout
LOG_LEVEL=info

# ---- HTTP transport only ----
HOST=127.0.0.1
PORT=3000

# Shared secret, at least 16 characters; clients send "Authorization: Bearer <token>".
# Required whenever HOST is not 127.0.0.1 / localhost / ::1. Generate: openssl rand -hex 32
# MCP_AUTH_TOKEN=

# Comma-separated Host header allowlist; set it when HOST=0.0.0.0 behind a domain
# MCP_ALLOWED_HOSTS=mcp.example.com

# ---- Tools ----
# Notion internal integration secret (https://www.notion.so/my-integrations);
# share each database with the integration before querying it.
# NOTION_TOKEN=
